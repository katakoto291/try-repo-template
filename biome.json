{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space"
  },
  "overrides": [
    {
      "includes": ["frontend/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/backend/**", "backend", "backend/**"],
                    "message": "frontend must not import from backend; share code via @repo/shared instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["backend/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/frontend/**", "frontend", "frontend/**"],
                    "message": "backend must not import from frontend; share code via @repo/shared instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
