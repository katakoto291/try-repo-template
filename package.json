{
  "name": "try-repo-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:versions": "node scripts/check-exact-versions.mjs",
    "format": "biome format --write .",
    "setup-hooks": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "lefthook": "2.1.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
